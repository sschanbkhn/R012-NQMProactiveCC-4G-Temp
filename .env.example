# === DATABASE ===
DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/r012_db

# === CDS API (SHA-512) ===
# BO CDS (18/10/2026): CDS_BASE_URL KHONG con duoc goi (adapter giu lai, khong
# noi day). CDS_CP_CODE/CDS_SECURE_KEY VAN BAT BUOC - CTS dung chung (duoi).
CDS_BASE_URL=https://gw-oneoss.vnpt.vn
CDS_CP_CODE=<your_cp_code_here>
CDS_SECURE_KEY=<your_secure_key_here>

# === CTS API (QoS metrics - dung chung credentials voi CDS) ===
CTS_BASE_URL=https://gw-oneoss.vnpt.vn
# Dung CDS_CP_CODE va CDS_SECURE_KEY - khong can key rieng

# === SaveCellClm (TTS/ApiCTS - cpCode RNOC1.TTS, secureKey RIENG khong dung chung CDS) ===
# HAI key KHAC NHAU, KHONG duoc dung chung 1 key cho ca 2 header:
#   CP_SECURE_KEY     -> ky X-Secure-Code (key cua cpCode)
#   ACCESS_SECURE_KEY -> sinh X-Access-Key (key cua user, khong doi theo cpCode)
SAVE_CELL_CLM_CP_SECURE_KEY=<your_cp_secure_key_here>
SAVE_CELL_CLM_ACCESS_SECURE_KEY=<your_access_secure_key_here>

# SOC API: da thay bang CEM API (xem khoi CEM cuoi file). OQ-01 dong.

# === CEM API (QoE muc cell) - auth SHA-256 + "@2022", KHAC CDS/CTS ===
# Do VNPT-TSC cap. Xem docs/DEV_LOG.md muc [CEM]
CEM_ACCOUNT=
CEM_HASH_KEY=
CEM_BASE_URL=https://api-cem.vnptmedia.vn
#
# CONG TAT nguon QoE (16082026):
#   false (MAC DINH) - dung SocHttpAdapter MOCK, tra qoe=3.5 CUNG cho moi cell.
#                      Day la trang thai tu truoc den nay (OQ-01).
#   true             - dung CemHttpAdapter, goi API CEM that (truong ux_final,
#                      thang 1-5).
#
# CAN THAN KHI BAT LEN: QoE that se THAM GIA danh gia cap session
# (EvaluateCrUseCase). Truoc day moi cell deu 3.5 nen qoe_before == qoe_after
# va qoe_result LUON PASS; bat len roi thi qoe_result CO THE thanh FAIL. Bat
# tren moi truong test truoc, doi chieu vai session roi moi bat that.
#
# LUU Y: CEM tre 2 NGAY (CTS tre 1 ngay) - cua so QoE lech 1 ngay so voi QoS.
# Ngay chua co du lieu se lam so ngay < 5 -> INSUFFICIENT_DATA -> session bi
# danh dau KHONG_DU_DU_LIEU (cach C, 16/08) - TRANG THAI CUOI, KHONG quet lai.
# (Truoc cach C la EVAL_PENDING va quet lai hang ngay - da bo.)
#
# GHI NHAN THUC TE: CEM co lo thung du lieu 16/07 va 21-27/07 -> cac session
# thang 7 deu ra INSUFFICIENT_DATA -> KHONG_DU_DU_LIEU.
CEM_ENABLED=false

# HAN GOI LAI CEM cho lazy cache qoe_snapshot (E1, 09/2026, quyet dinh van
# hanh). CEM KHONG backfill lo thung du lieu qua khu (16/07, 21-27/07 o tren
# se KHONG BAO GIO duoc lap day) - neu cu goi lai CEM moi khi snapshot thieu
# < 7 ngay/period thi lo thung bien thanh VONG GOI VO HAN: moi lan mo tab QoE
# la 15 request CEM (14 + 1 ngay T) ma KHONG BAO GIO du. Qua so ngay nay ke tu
# ngay CR (GMT+7) -> tra nguyen snapshot cache dang co (du thieu), NGUNG goi
# CEM. Xem application/get_qoe_cells_use_case.py::_doc_snapshot_neu_du().
SNAPSHOT_HAN_GOI_LAI_NGAY=14

# === ENODEB LIST API ===
ENODEB_API_URL=http://<enodeb_internal_ip>:8080/application/g/enodeb_list
ENODEB_BEARER_TOKEN=<jwt_token_co_dinh>
# CANH BAO: chi goi duoc tu server 10.155.43.196

# === NETACT SSH (multi-vung - xem TASK_LIST.md KI-08) ===
# Doi tu NETACT_HOST/USER/PASSWORD don sang JSON nay khi phat hien can ho tro
# nhieu vung NetAct (mot host rieng cho HNI, mot host dung chung cho 7 tinh
# Netact14) - xem adapters/netact/oss_router_env.py (Giai doan 1 buoc 2).
#
# SUA 27/09/2026 (Giai doan 1 buoc 2, dinh tuyen OSS THEO TUNG CELL - khong
# phai theo tram tat): dinh dang MOI co 2 phan:
#   "instances" - 1 OSS vat ly = 1 khoa (instance_id tu dat, vd "NA09"/"NA14"
#                 khop ten goi NetAct that - KI-08).
#   "routes"    - khoa "<ma_tinh_cu>|<vendor>" -> instance_id. ma_tinh_cu la
#                 MA TINH CU (truoc sap nhap, suy tu 3 ky tu cuoi TEN CELL -
#                 xem domain/services/oss_routing.py) - KHONG PHAI cot
#                 tram.ma_tinh (ma MOI sau sap nhap, xem BUSINESS_RULES.md
#                 muc dinh tuyen OSS). NHIEU tinh cu co the tro ve CUNG 1
#                 instance (vd ca 7 tinh Netact14 -> "NA14").
# Adapter (OssRouterEnv) VAN doc duoc dinh dang CU (phang, vd
# {"HNI":{host,user,password}}) - server that (.196/.197) KHONG bat buoc
# phai sua .env cung luc voi deploy code nay, xem docstring OssRouterEnv.
#
# Gia tri duoi day la GIA (khong phai host/user/password that).
#
# THEM 23/10/2026 - UU TIEN file JSON rieng (moi NA 1 khoi, moi mat khau 1 lan;
# mau: netact_servers.example.json, password de trong). Co bien nay thi
# NETACT_SERVERS ben duoi chi la du phong. .env phai giu MOI BIEN 1 DONG (service
# .196 nap bang systemd EnvironmentFile) - KHONG viet JSON nhieu dong o day.
# Xem docs/DEPLOY.md muc "CAU HINH NETACT".
NETACT_SERVERS_FILE=/home/auto/secrets/r012_netact_servers.json
NETACT_SERVERS={"instances":{"NA09":{"host":"<netact_host_hni>","user":"<username>","password":"<password>"},"NA14":{"host":"<netact_host_netact14>","user":"???","password":"???"}},"routes":{"HNI|NOKIA":"NA09","CBG|NOKIA":"NA14","DBN|NOKIA":"NA14","SLA|NOKIA":"NA14","HGG|NOKIA":"NA14","LCU|NOKIA":"NA14","LSN|NOKIA":"NA14","LCI|NOKIA":"NA14"}}
#
# CANH BAO MOI (BUOC 4b, 08/10/2026): nhanh HO (tu 18/10/2026 la nguon duy nhat) dung CHINH
# instance_id cua NETACT_SERVERS lam khoa "netact" de doc bang ho_neighbor
# (vd "NA09" - PHAI khop CHINH XAC gia tri --netact da dung luc chay
# adapters/netact/import_ho_neighbor.py). Neu .env server THAT van con dang
# dinh dang CU (phang, vd {"HNI":{host,user,password}}) thi instance_id se LA
# HOST (IP), KHONG PHAI "NA09" - nhanh HO se LUON raise 422
# KHONG_CO_DU_LIEU_HO (khong tim thay netact dung) du da nap du lieu. PHAI
# chuyen NETACT_SERVERS server THAT sang dinh dang MOI (instances/routes,
# giu NGUYEN host/user/password that, chi doi "key") TRUOC KHI dat
# cho vung tuong ung - adapters/netact/oss_router_env.py
# KHONG can sua code, chi can sua gia tri .env.

# BO CDS (18/10/2026, quyet dinh user): cong tac NEIGHBOR_SOURCE DA BO - xem
# truoc/chay CR CHI dung HO + Delaunay (bang ho_neighbor). Bien nay co con
# trong .env cung KHONG duoc doc nua, xoa duoc.
# SUA 14/08 - ban cu SAI DUONG DAN, thieu 3 doan:
#   .../scheduler/exportCustom/R012-NQMProactiveCC/          <- CU (sai)
#   .../scheduler/export/exportCustom/Schan/CDS/R012-NQMProactiveCC-4G/  <- DUNG
# Thieu 'export/', thieu 'Schan/CDS/', thieu hau to '-4G'.
# DAY CHINH LA LOI DA GAP TREN .env CUA .196 NGAY 13/08: upload XML vao thu muc
# KHONG TON TAI -> CR that fail o buoc SFTP. Loi khong lo ra luc khoi dong app
# (khong ai kiem duong dan SFTP luc boot) ma chi no giua chung 1 CR that.
# Ai copy file mau nay ra dung deu dinh dung loi do -> phai sua o file mau,
# khong chi sua rieng .env cua .196.
NETACT_UPLOAD_PATH=/d/oss/global/var/pm/shared/content3/scheduler/export/exportCustom/Schan/CDS/R012-NQMProactiveCC-4G/
# C1.4-fix5 (20072026): 600s (10 phut) - Provision that tren thiet bi mang
# that co the mat vai phut, ap dung RIENG cho MOI lenh (Import va Provision
# moi lenh 600s doc lap, khong phai tong). 120s cu tung cat nham gay FAILED oan.
NETACT_SSH_TIMEOUT=30
NETACT_CMD_TIMEOUT=600

# === APP CONFIG ===
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
EVALUATION_DAYS=21

# === JOB TU DONG XUAT PHIEU (JOB TU DONG buoc 2/4) ===
# So ngay sau CR moi bat dau xuat phieu = 8, KHONG phai 7 (sua 12/08).
# TAI SAO 8: CTS chi co data den HET HOM QUA (T-1). CR chay ngay 20 -> cua so
# danh gia sau la 21..27. Sang ngay 27 CTS moi co data den 26 -> chi duoc 6/7
# ngay. Sang ngay 28 moi du ca 21..27 = 7/7 ngay. Danh gia chi dien ra MOT LAN
# (xuat phieu xong la cell bi loai khoi vong quet) nen phai du data TRUOC khi
# ket luan, khong co lan 2 de sua.
# KHONG dung lai EVALUATION_DAYS (21) - 2 moc nghiep vu khac nhau (21 ngay la
# danh gia PASS/FAIL cap session).
XUAT_PHIEU_AFTER_DAYS=8
# SUA 03/10/2026 (QUET BU) - so ngay job tu dong "nhin lui" de bat lai cac
# session co ngay CR roi dung moc XUAT_PHIEU_AFTER_DAYS nhung LO vi job
# khong chay dung hom do (server down, deploy loi...). Ca THAT lam phat
# sinh thay doi nay: session 7296 (CR 15/09/2026) KHONG bao gio duoc job tu
# dong quet toi, phai cho nguoi chay tay. Cua so quet moi la [hom_nay -
# XUAT_PHIEU_AFTER_DAYS - XUAT_PHIEU_QUET_BU_NGAY, hom_nay - XUAT_PHIEU_AFTER_DAYS].
# VAN AN TOAN KHONG xuat trung: dieu kien chon session CON co
# "xuat_phieu_at IS NULL" (session da xu ly xong 1 LAN roi thi khong bao
# gio duoc chon lai, du con nam trong cua so).
XUAT_PHIEU_QUET_BU_NGAY=14
# Tran so phieu xuat tu dong cho 1 SECTOR cua tram tat trong 1 luot chay
# (SUA 04/10/2026 - THAY THE XUAT_PHIEU_MAX_PER_SESSION cu, tran gio tinh
# theo sector chu khong theo ca session - tram 4 sector toi da 4x2=8 phieu).
# Cell vuot tran duoc ghi thanh dong cr_phieu trang_thai
# KHONG_XUAT_VUOT_GIOI_HAN (V4) de nguoi van hanh loc ra xu ly tay, KHONG
# bien mat im lang. File .env THAT bi .gitignore nen doi o day KHONG lam doi
# tran tren server - phai sua tay .env cua .196.
XUAT_PHIEU_MAX_PER_SECTOR=2

# === SCHEDULER (JOB TU DONG buoc 3/4) ===
# CHI CON 1 CO (V2, 12/08 - da bo XUAT_PHIEU_AUTO_ENABLED cung voi dry_run):
#   SCHEDULER_ENABLED=true -> job chay dung gio moi ngay VA POST PHIEU THAT
#   len TTS. Khong con che do "chay lich nhung khong gui gi".
# Chi gia tri "true" (khong phan biet hoa thuong) moi la BAT - moi gia tri khac
# deu la TAT (lien quan WRITE API that len TTS, mac dinh phai an toan).
#
# !!! MAC DINH LA TAT (false) - CO Y !!!
# File nay la thu NGUOI TRIEN KHAI copy thanh .env. De san "true" o day thi moi
# moi truong moi (may dev khac, server moi, container moi) se BAT scheduler
# ngay tu lan chay dau - ma sau V2 thi khong con che do chay thu: bat la job
# POST PHIEU THAT len CTS/TTS luc 8h sang. Mac dinh cua file mau phai la trang
# thai AN TOAN NHAT, khong phai trang thai may dev dang chay.
#
# Chi bat CO Y khi da san sang nghiem thu (doi thanh true trong .env RIENG cua
# moi truong do, KHONG sua file mau nay).
#
# !!! DUNG HIEU NHAM "bat co ma khong thay gi xay ra = an toan" !!!
# Job im lang la vi moi ngay CHI quet CUA SO [hom_nay-AFTER_DAYS-QUET_BU,
# hom_nay-AFTER_DAYS] (xem XUAT_PHIEU_QUET_BU_NGAY o tren). Ngay nao khong
# co CR nao roi vao cua so do thi job chay xong voi 0 session - KHONG phai
# vi no dang o che do thu. Co CR trong cua so, no se POST PHIEU THAT len
# TTS ma khong hoi ai.
SCHEDULER_ENABLED=false
# Gio chay theo GIO VN (scheduler set timezone=Asia/Ho_Chi_Minh) - quy trinh
# TTS nhan phieu cua so 8h00-8h30. Tre qua 30 phut thi BO luot, cho hom sau -
# nhung khac PA A cu (SUA 03/10/2026), bo 1 luot KHONG con mat vinh vien ngay
# CR do nua - XUAT_PHIEU_QUET_BU_NGAY se tu bat lai o lan chay ke tiep.
SCHEDULER_HOUR=8
SCHEDULER_MINUTE=0

# So lan POST THAT toi da cho 1 cell. Phieu FAILED do loi DU LIEU (vd CTS tra
# 400 vi 1 field sai) se hong y het o moi lan chay - khong gioi han thi job thu
# lai VO HAN, rac log va lam mat long tin vao canh bao.
# V3 (12/08) dung con so nay cho CA HAI cho, cung y nghia "so lan da lam phien
# CTS cho cell nay":
#   - so lan thu lai NGAY TRONG 1 luot goi (chi thu lai khi loi mang/timeout
#     hoac CTS tra 5xx; 4xx va 200+isError thi DUNG NGAY, thu lai vo ich)
#   - tran tich luy tren cot cr_phieu.so_lan_thu -> cham tran thi job NGUNG thu,
#     ghi dong cr_phieu trang_thai KHONG_XUAT_HET_LUOT_THU de nguoi xu ly tay
#     (phai sua nguyen nhan goc, khong phai thu lai)
XUAT_PHIEU_MAX_RETRY=3
